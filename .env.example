# Environment Configuration for AgriSure Intelligence
NODE_ENV=production
PORT=3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://user:password@host:5432/agrisure_db?schema=public&sslmode=require"

# Auth / JWT (Cryptographically Generated Secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-random-32-character-secret-string"
NEXTAUTH_URL="https://your-production-domain.com"

# Simulation Configurations & Regional Pilot Settings
IOT_POLL_INTERVAL_MS=3000
DEMO_PRIMARY_PLOT="Plot #204"
DEMO_VILLAGE="Ghatal"
DEMO_DISTRICT="Ghatal, Paschim Medinipur"

# Satellite & Weather Simulation Flags
SIMULATE_SENTINEL_FEEDS=true

# Payment Gateway Policy: Disabled for now (Direct banking payouts held)
SIMULATE_BANK_GATEWAY=false

# --- OPTIONAL EXTERNAL PRODUCTION INTEGRATIONS (PLACEHOLDERS) ---
# 1. Copernicus Data Space Ecosystem (Sentinel-1 & Sentinel-2 Feeds)
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# 2. OpenWeatherMap API (Live Weather & Precipitation)
OPENWEATHER_API_KEY=""

# 3. RazorpayX Payouts API (Direct Benefit Transfer NEFT Gateway - Currently Inactive)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# 4. Twilio SMS & Voice Advisories (Rural Farmer Alerts)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# 5. HiveMQ Cloud MQTT Broker (Physical ESP32 Soil Probes)
MQTT_BROKER_URL=""
MQTT_USERNAME=""
MQTT_PASSWORD=""
