# Environment Configuration for AgriSure Intelligence
NODE_ENV=development
PORT=3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://agrisure_user:agrisure_secure_pass@localhost:5432/agrisure_db?schema=public"

# Auth / JWT (Simulated demo security)
JWT_SECRET="agrisure-super-secure-jwt-secret-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# Simulation Configurations
IOT_POLL_INTERVAL_MS=3000
DEMO_PRIMARY_PLOT="Plot #204"
DEMO_DISTRICT="Nadia"

# Satellite & Weather Simulation Flags
SIMULATE_SENTINEL_FEEDS=true
SIMULATE_BANK_GATEWAY=true
